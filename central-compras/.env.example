# Copie este arquivo para .env e ajuste os valores para seu ambiente.

APP_NAME=Central de Compras
# VALOR GENERICO: configuracao de desenvolvimento local.
# Opcional para desenvolvimento local. Mantido comentado para que a copia deste arquivo nao habilite o atalho automaticamente.
# APP_ENV=development
# VALOR GENERICO: senha mestra de desenvolvimento.
# APP_DEV_LOGIN_PASSWORD=

# MySQL.
DB_HOST=
DB_PORT=
DB_NAME=
# VALOR GENERICO: usuario padrao XAMPP; prefira usuario MySQL dedicado.
DB_USER=
# VALOR GENERICO: senha local vazia comum em XAMPP; defina a senha real.
DB_PASSWORD=

# Solicitar credenciais
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=naoresponda@logos-ma.com.br
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_NAME="Central de Compras"
MAIL_FROM_ADDRESS=naoresponda@logos-ma.com.br

# SSO Portal de Acesso Integrado.
# VALOR GENERICO: substituir pelo aud configurado no Portal para este ambiente.
PORTAL_SSO_AUD_VALIDOS=central-compras
# VALOR GENERICO: preencher com segredo hexadecimal de 64 caracteres recebido por canal seguro.
PORTAL_SSO_SECRET_CENTRAL_COMPRAS=
# VALOR GENERICO: dominio corporativo de exemplo; ajustar ou deixar vazio para desativar a restricao.
PORTAL_SSO_DOMINIO_EMAIL=@logos.com.br
# VALOR GENERICO: confirmar o tamanho de matricula esperado; o guia sugere seis digitos.
PORTAL_SSO_MATRICULA_DIGITOS=6

# Proxy reverso.
# VALOR GENERICO: mantenha 0 salvo quando houver proxy confiavel devidamente configurado.
APP_TRUST_X_FORWARDED_PROTO=0
